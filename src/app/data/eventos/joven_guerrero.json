              "seguidor": "nativo"
            }
          ]
        },
        {
          "texto": "Hacerle sitio despidiendo a alguien",
          "hacerSitio": true,
          "efectos": [
            {
              "tipo": "ganar_seguidor",
              "seguidor": "nativo"
            }
          ]
        },
        {
          "texto": "Que se una a la tripulación",
          "efectos": [
