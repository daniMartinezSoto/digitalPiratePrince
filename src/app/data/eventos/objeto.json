                "tipo": "comida",
                "cantidad": 10
              }
            ]
          },
          {
            "min": 4,
            "max": 4,
            "texto": "Dentro hay un cofrecito lleno de monedas.",
            "efectos": [
              {
                "tipo": "oro",
                "cantidad": 50
              }
            ]
          },
          {
            "min": 5,
            "max": 5,
            "texto": "Dentro hay algo de valor.",
            "evento": "tesoro"
          },
          {
            "min": 6,
            "max": 6,
            "texto": "¡Es tu día de suerte! Dentro hay algo muy especial...",
            "evento": "tesoro_magico"
          }
        ]
      }
    },
    "naufrago": {
      "texto": "Podría acompañarte como seguidor, para siempre. O, si no tienes sitio o no lo quieres a tu lado, trabajar como uno más de tu tripulación.",
      "opciones": [
        {
          "texto": "Que te acompañe como seguidor",
          "requiere": {
            "puedeGanarSeguidor": true
          },
          "efectos": [
            {
              "tipo": "ganar_seguidor",
              "seguidor": "al_azar",
