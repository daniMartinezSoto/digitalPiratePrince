            }
          ]
        },
        {
          "texto": "Hacerle sitio despidiendo a alguien",
          "hacerSitio": true,
          "efectos": [
            {
              "tipo": "ganar_seguidor",
              "seguidor": "al_azar",
              "inseparable": true
            }
          ]
        },
        {
          "texto": "Que se una a la tripulación",
          "efectos": [
            {
              "tipo": "tripulacion",
              "cantidad": 1
            }
          ]
        }
      ]
